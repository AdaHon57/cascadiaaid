# Both document text extraction and house-photo analysis require these values.
# Copy to .env.local for local development. Keep secrets out of source control.
OPENAI_API_KEY=
# A model supporting image inputs and structured Responses API output.
OPENAI_VISION_MODEL=gpt-4.1-mini
# Set a random code of at least 24 characters; share only with authorized testers.
# This protects the paid image endpoint until per-user authentication is added.
IMAGE_ANALYSIS_ACCESS_CODE=

# Optional: enable support answers and recovery draft writing using the server's OPENAI_API_KEY.
# Leave blank for source excerpts only. Choose a model supporting structured output.
OPENAI_SUPPORT_MODEL=

# Real application automation. Run npm run automation on a trusted machine.
# Both the site and automation service must use the same random 32+ character token.
AUTOMATION_SERVICE_URL=http://127.0.0.1:4318
AUTOMATION_SERVICE_TOKEN=
# Defaults to OPENAI_SUPPORT_MODEL if omitted; must support web search and structured output.
OPENAI_AUTOMATION_MODEL=
# false shows the local browser so the person can complete login/signature steps.
AUTOMATION_HEADLESS=false
